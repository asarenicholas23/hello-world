rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    // Staff doc is keyed by Firebase Auth UID — O(1) lookup, no query needed.
    function staffRole() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role;
    }

    function isDirector()         { return isAuthed() && staffRole() == 'director'; }
    function isAdmin()            { return isAuthed() && staffRole() == 'admin'; }
    function isSeniorOfficer()    { return isAuthed() && staffRole() == 'senior_officer'; }
    function isOfficer()          { return isAuthed() && staffRole() == 'officer'; }
    function isAssistantOfficer() { return isAuthed() && staffRole() == 'assistant_officer'; }
    function isJuniorOfficer()    { return isAuthed() && staffRole() == 'junior_officer'; }
    function isFinance()          { return isAuthed() && staffRole() == 'finance'; }

    // Any role that does field work
    function isFieldRole() {
      return isSeniorOfficer() || isOfficer() || isAssistantOfficer() || isJuniorOfficer();
    }

    // Separately-granted, role-independent permission: lets a staff member
    // update/create records and reports without changing their role. Only
    // an admin can set this (see staff/{uid} rules below). Deliberately does
    // NOT fold into isAdmin()/ADMIN_ROLES-gated actions (deletes, staff
    // management, workflow approvals) — only into canEditAllEntries().
    function hasDataAccess() {
      return isAuthed() && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.get('data_access', false) == true;
    }

    function canEditAllEntries() {
      return isDirector() || isAdmin() || isSeniorOfficer() || isOfficer() || hasDataAccess();
    }

    // ── Staff ──────────────────────────────────────────────────
    // Any authenticated user can read staff docs (needed for name lookups).
    // Admin can do anything. A user can update their own doc provided they
    // don't change their role, system_id, or role_level. staff_id (the real,
    // management-issued ID) is intentionally self-editable.
    match /staff/{uid} {
      allow read:             if isAuthed();
      allow create, delete:   if isAdmin();
      allow update:           if isAdmin()
                                || (isAuthed() && request.auth.uid == uid
                                    && request.resource.data.role       == resource.data.role
                                    && request.resource.data.system_id  == resource.data.system_id
                                    && request.resource.data.role_level == resource.data.role_level
                                    && request.resource.data.get('data_access', false) == resource.data.get('data_access', false));
    }

    // ── Counters ───────────────────────────────────────────────
    // Legacy file-number counters retained for existing data/admin scripts.
    match /counters/{prefix} {
      allow read, write: if isAuthed();
    }

    // ── Facilities ─────────────────────────────────────────────
    match /facilities/{fileNumber} {
      allow read:          if isAuthed();
      allow create:        if isAdmin() || isFieldRole() || hasDataAccess();
      allow update:        if canEditAllEntries() || isFinance() || isFieldRole();
      allow delete:        if canEditAllEntries();

      // Permits — admin/director full access; assigned field officer can create
      match /permits/{id} {
        allow read:           if isAuthed();
        allow create:         if isAdmin() || isDirector() || hasDataAccess()
                                || (isFieldRole() && get(/databases/$(database)/documents/facilities/$(fileNumber)).data.primary_officer == request.auth.uid);
        allow update:         if canEditAllEntries();
        allow delete:         if canEditAllEntries();
      }

      // Assignment history on the facility itself (append-only)
      match /assignment_history/{hid} {
        allow read:           if isAuthed();
        allow create:         if canEditAllEntries() || isFieldRole();
        allow update, delete: if false;
      }

      // Permit workflows — one workflow case per permit.
      match /permit_workflows/{id} {
        allow read:           if isAuthed();
        allow create, update: if canEditAllEntries() || isFieldRole() || isFinance();
        allow delete:         if canEditAllEntries();
      }

      // Finance — admin, director, or finance role
      match /finance/{id} {
        allow read:        if isAuthed();
        allow create:      if canEditAllEntries() || isFinance();
        allow update:      if canEditAllEntries() || isFinance();
        allow delete:      if canEditAllEntries() || isFinance();
      }

      // Field sub-records — admin or any field role
      match /screenings/{id} {
        allow read:        if isAuthed();
        allow write:       if canEditAllEntries() || isFieldRole();
      }

      match /site_verifications/{id} {
        allow read:        if isAuthed();
        allow write:       if canEditAllEntries() || isFieldRole();
      }

      match /monitoring/{id} {
        allow read:        if isAuthed();
        allow write:       if canEditAllEntries() || isFieldRole();
      }

      match /enforcement/{id} {
        allow read:        if isAuthed();
        allow write:       if canEditAllEntries() || isFieldRole();
      }

      // Monitoring report uploads — tagged to a senior officer for review
      match /monitoring_reports/{id} {
        allow read:        if isAuthed();
        allow write:       if canEditAllEntries() || isFieldRole();
      }
    }

    // ── Field Reports (top-level collection for unregistered facilities) ──
    match /field_reports/{id} {
      allow read:   if isAuthed();
      allow create: if canEditAllEntries() || isFieldRole();
      allow update: if canEditAllEntries() || isFieldRole() || isFinance();
      allow delete: if canEditAllEntries();

      match /assignment_history/{hid} {
        allow read:           if isAuthed();
        allow create:         if canEditAllEntries() || isFieldRole();
        allow update, delete: if false;
      }
    }

    // ── Tasks (standalone assign-a-specific-job feature) ───────────
    match /tasks/{id} {
      allow read:   if isAuthed();
      allow create: if (canEditAllEntries() || isFieldRole())
                     && request.resource.data.assigned_by == request.auth.uid;
      // The assignee may update their own task (submit/resubmit) but may not
      // set status to 'approved' themselves — only the assigner (or admin)
      // can approve, preserving the review gate the feature exists for.
      allow update: if canEditAllEntries()
                     || (isAuthed() && resource.data.assigned_by == request.auth.uid)
                     || (isAuthed()
                         && (resource.data.assigned_to == request.auth.uid || resource.data.assigned_to_2 == request.auth.uid)
                         && request.resource.data.status != 'approved');
      allow delete: if canEditAllEntries();
    }

    // ── Complaints ─────────────────────────────────────────────────
    match /complaints/{id} {
      allow read:          if isAuthed();
      allow create:        if canEditAllEntries() || isFieldRole();
      allow update:        if canEditAllEntries() || (isFieldRole() && resource.data.created_by == request.auth.uid);
      allow delete:        if isAdmin();
    }

    // ── Environmental Education ────────────────────────────────────
    match /environmental_education/{id} {
      allow read:          if isAuthed();
      allow create:        if canEditAllEntries() || isFieldRole();
      allow update:        if canEditAllEntries() || (isFieldRole() && resource.data.created_by == request.auth.uid);
      allow delete:        if isAdmin();
    }

    // ── Attendance (clock in / clock out) ──────────────────────────
    // Doc ID is `${uid}_${date}`, so the first write for a given day is
    // necessarily a `create` and the second (clock-out) is an `update` —
    // this lets us make clock-in fields immutable and clock-out settable
    // exactly once, without a transaction.
    match /attendance/{id} {
      allow read: if isAuthed()
                  && (resource == null || resource.data.staff_uid == request.auth.uid || canEditAllEntries());

      allow create: if isAuthed()
                    && request.resource.data.staff_uid == request.auth.uid
                    && request.resource.data.clock_in_at == request.time
                    && request.resource.data.clock_out_at == null;

      allow update: if isAuthed()
                    && resource.data.staff_uid == request.auth.uid
                    && request.resource.data.staff_uid           == resource.data.staff_uid
                    && request.resource.data.date                == resource.data.date
                    && request.resource.data.clock_in_at         == resource.data.clock_in_at
                    && request.resource.data.clock_in_coords     == resource.data.clock_in_coords
                    && request.resource.data.clock_in_distance_m == resource.data.clock_in_distance_m
                    && resource.data.clock_out_at == null
                    && request.resource.data.clock_out_at == request.time;

      allow delete: if isAdmin();
    }

    // ── In-app notifications ─────────────────────────────────────
    match /notifications/{id} {
      allow read:   if isAuthed() && resource.data.recipient_uid == request.auth.uid;
      allow create: if isAuthed();
      allow update: if isAuthed() && resource.data.recipient_uid == request.auth.uid;
      allow delete: if false;
    }

    // ── SMS log (written only by Cloud Functions via Admin SDK) ───
    match /sms_log/{id} {
      allow read:  if isAdmin() || isDirector() || hasDataAccess();
      allow write: if false;
    }
    match /sms_dedup/{id} {
      allow read, write: if false;
    }

    // ── Email log (written only by Cloud Functions via Admin SDK) ─
    match /email_log/{id} {
      allow read:  if isAdmin() || isDirector() || hasDataAccess();
      allow write: if false;
    }

    // ── collectionGroup reads (cross-facility views & dashboard) ──
    // These wildcard rules allow collectionGroup() queries used on the
    // dashboard and cross-facility listing pages. Write access is still
    // governed by the specific subcollection rules above.
    match /{path=**}/permits/{id}            { allow read: if isAuthed(); }
    match /{path=**}/permit_workflows/{id}   { allow read: if isAuthed(); }
    match /{path=**}/assignment_history/{id}  { allow read: if isAuthed(); }
    match /{path=**}/finance/{id}            { allow read: if isAuthed(); }
    match /{path=**}/screenings/{id}         { allow read: if isAuthed(); }
    match /{path=**}/site_verifications/{id} { allow read: if isAuthed(); }
    match /{path=**}/monitoring/{id}         { allow read: if isAuthed(); }
    match /{path=**}/enforcement/{id}        { allow read: if isAuthed(); }
  }
}
